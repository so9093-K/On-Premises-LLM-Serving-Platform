{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MainModelOperationResponse",
  "type": "object",
  "required": [
    "id",
    "requested_profile",
    "previous_profile",
    "client_request_id",
    "status",
    "stage",
    "error",
    "rollback_error",
    "recovered_after_restart",
    "created_at",
    "updated_at"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "requested_profile": {
      "type": "string",
      "minLength": 1
    },
    "previous_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "client_request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "type": "string",
      "description": "Operation lifecycle/result. Terminal values are completed, failed, and rollback_failed.",
      "enum": [
        "pending",
        "preparing",
        "draining",
        "stopping",
        "starting",
        "validating",
        "rolling_back",
        "completed",
        "failed",
        "rollback_failed"
      ]
    },
    "stage": {
      "type": "string",
      "description": "Controller execution stage. On terminal failure this preserves the stage where the target transition failed, so status=failed may coexist with stage=preparing/draining/starting/validating.",
      "enum": [
        "pending",
        "preparing",
        "draining",
        "stopping",
        "starting",
        "validating",
        "rolling_back",
        "completed",
        "failed",
        "rollback_failed"
      ]
    },
    "error": {
      "type": [
        "string",
        "null"
      ]
    },
    "rollback_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "number",
      "minimum": 0
    },
    "updated_at": {
      "type": "number",
      "minimum": 0
    },
    "recovered_after_restart": {
      "type": "boolean",
      "description": "true면 process restart 뒤 실제 runtime을 재관측해 이 operation을 terminal 상태로 복구했다."
    }
  }
}
