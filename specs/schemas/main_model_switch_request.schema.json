{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MainModelSwitchRequest",
  "type": "object",
  "required": [
    "profile"
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "confirm_unverified": {
      "type": "boolean",
      "default": false
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "execution_policy": {
      "type": "string",
      "enum": [
        "automatic",
        "cpu",
        "gpu"
      ],
      "description": "자동 선택은 CPU부터 검증하며, cpu/gpu는 선택한 엔진을 유지합니다."
    }
  }
}
