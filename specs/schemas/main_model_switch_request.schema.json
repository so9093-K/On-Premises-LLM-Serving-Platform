{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MainModelSwitchRequest",
  "type": "object",
  "required": [
    "profile"
  ],
  "additionalProperties": false,
  "properties": {
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "server_limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Runtime Controller 관리형 모델의 서버 문맥과 최대 출력 토큰. 실행 엔진과 Gateway에 함께 적용하며 미검증 설정 확인이 필요합니다.",
      "required": ["context_tokens", "max_output_tokens"],
      "properties": {
        "context_tokens": {"type": "integer", "minimum": 1},
        "max_output_tokens": {"type": "integer", "minimum": 1}
      }
    },
    "confirm_unverified": {
      "type": "boolean",
      "default": false
    },
    "request_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._:-]+$"
    },
    "execution_policy": {
      "type": "string",
      "enum": [
        "fallback",
        "automatic",
        "cpu",
        "gpu"
      ],
      "description": "fallback은 GPU 우선·CPU 복구 후 GPU 복귀는 수동, automatic은 CPU/GPU 자동 전환, cpu/gpu는 엔진 고정입니다."
    }
  }
}
