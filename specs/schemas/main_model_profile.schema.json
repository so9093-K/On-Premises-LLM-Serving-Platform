{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MainModelProfile",
  "type": "object",
  "required": [
    "id",
    "display_name",
    "served_model_name",
    "upstream_model_id",
    "revision",
    "compatibility",
    "qualification",
    "capabilities",
    "gateway_policy",
    "runtime_image",
    "vram_fraction"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "required": [
          "runtime_backend"
        ],
        "properties": {
          "runtime_backend": {
            "const": "llama-cpp"
          }
        }
      },
      "then": {
        "properties": {
          "vram_fraction": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "vram_fraction": {
            "exclusiveMinimum": 0
          }
        }
      }
    }
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "context_tokens_ceiling": {
      "type": "integer",
      "minimum": 1,
      "description": "관리형 CPU 모델의 허용 문맥 상한. 선언된 기준 프로필의 현재 문맥과 다를 수 있습니다."
    },
    "base_profile_id": {
      "type": "string",
      "minLength": 1,
      "description": "사용자 지정 실행 한도가 파생된 기준 프로필. 선언된 원본 프로필에는 없습니다."
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "served_model_name": {
      "type": "string",
      "minLength": 1
    },
    "upstream_model_id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "compatibility": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "compatible",
            "incompatible",
            "unknown"
          ]
        }
      }
    },
    "capabilities": {
      "type": "object",
      "required": [
        "deployed_input"
      ],
      "additionalProperties": false,
      "properties": {
        "deployed_input": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "text",
              "image",
              "audio",
              "video"
            ]
          }
        }
      }
    },
    "gateway_policy": {
      "type": "object",
      "additionalProperties": true
    },
    "runtime_image": {
      "type": "string",
      "minLength": 1
    },
    "vram_fraction": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "resource_variant": {
      "type": ["string", "null"],
      "minLength": 1,
      "description": "Explicit resource-policy override applied on this host. null means the profile reference policy; it is not a hardware support verdict."
    },
    "resource_variants": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "Reviewed resource-policy override IDs declared by the profile. This is not a supported-GPU allowlist."
    },
    "switch_preflight": {
      "type": "object",
      "description": "현재 GPU 예약 정책에 대한 읽기 전용 사전 판단이다. fits는 모델 적재 성공을 보장하지 않는다.",
      "additionalProperties": false,
      "required": ["status", "reason_code", "required_fraction", "available_fraction", "ceiling_fraction", "stop"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["current", "blocked", "fits", "needs_stop", "infeasible", "unknown"]
        },
        "reason_code": {"type": ["string", "null"]},
        "required_fraction": {"type": ["number", "null"]},
        "available_fraction": {"type": ["number", "null"]},
        "ceiling_fraction": {"type": ["number", "null"]},
        "stop": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "active": {
      "type": "boolean"
    },
    "qualification": {
      "type": "object",
      "required": [
        "status"
      ],
      "additionalProperties": true,
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "verified",
            "unverified"
          ]
        }
      }
    },
    "runtime_backend": {
      "type": "string",
      "enum": [
        "vllm-cuda",
        "llama-cpp"
      ]
    }
  }
}
