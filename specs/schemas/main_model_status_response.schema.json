{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MainModelStatusResponse",
  "type": "object",
  "required": [
    "public_model",
    "active_profile",
    "gate",
    "runtime_state",
    "profile_locked",
    "boot_profile",
    "last_operation",
    "runtime_image",
    "observed_runtime"
  ],
  "additionalProperties": true,
  "properties": {
    "public_model": {
      "type": "string",
      "minLength": 1
    },
    "active_profile": {
      "anyOf": [
        {
          "$ref": "main_model_profile.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "last_known_good_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_known_good_profile": {
      "type": [
        "string",
        "null"
      ]
    },
    "gate": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ]
    },
    "runtime_state": {
      "type": "string",
      "enum": [
        "active",
        "stopped"
      ]
    },
    "profile_locked": {
      "type": "boolean"
    },
    "boot_profile": {
      "type": "string",
      "minLength": 1
    },
    "last_operation": {
      "anyOf": [
        {
          "$ref": "main_model_operation_response.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "stats": {
      "type": "object",
      "additionalProperties": true
    },
    "runtime_image": {
      "type": [
        "string",
        "null"
      ]
    },
    "state_recovery_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_runtime": {
      "anyOf": [
        {
          "type": "object",
          "required": [
            "status",
            "container_state",
            "health",
            "profile_id",
            "observed_at"
          ],
          "additionalProperties": true,
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "container_state": {
              "type": [
                "string",
                "null"
              ]
            },
            "health": {
              "type": [
                "string",
                "null"
              ]
            },
            "profile_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "image_ref": {
              "type": [
                "string",
                "null"
              ]
            },
            "image_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "image_digest": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "runtime_engine": {
              "anyOf": [
                {
                  "type": "object",
                  "required": [
                    "name",
                    "version"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1
                    },
                    "version": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                },
                {
                  "type": "null"
                }
              ]
            },
            "error": {
              "type": [
                "string",
                "null"
              ]
            },
            "observed_at": {
              "type": "number",
              "minimum": 0
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "runtime_selection": {
      "type": "object",
      "required": [
        "mode",
        "reason_code"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "automatic",
            "cpu",
            "gpu"
          ]
        },
        "reason_code": {
          "type": "string"
        },
        "active_profile": {
          "type": [
            "string",
            "null"
          ]
        },
        "observed_at": {
          "type": "number",
          "minimum": 0
        },
        "gpu_retry_at": {
          "type": "number",
          "minimum": 0
        },
        "cpu_retry_at": {
          "type": "number",
          "minimum": 0
        },
        "last_activation_at": {
          "type": "number",
          "minimum": 0
        },
        "healthy_samples": {
          "type": "integer",
          "minimum": 0
        },
        "failure_samples": {
          "type": "integer",
          "minimum": 0
        },
        "last_failed_operation": {
          "type": "string"
        },
        "resources": {
          "type": "object",
          "required": [
            "gpus",
            "ram_available_mib",
            "gpu_observation_error"
          ],
          "additionalProperties": false,
          "properties": {
            "gpus": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "index",
                  "total_mib",
                  "free_mib"
                ],
                "additionalProperties": false,
                "properties": {
                  "index": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "total_mib": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "free_mib": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "name": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "uuid": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "pci_bus_id": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "compute_capability": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "driver_version": {
                    "type": [
                      "string",
                      "null"
                    ]
                  }
                }
              }
            },
            "ram_available_mib": {
              "type": [
                "integer",
                "null"
              ],
              "minimum": 0
            },
            "gpu_observation_error": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "gpu_condition": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "GPU_RUNTIME_UNHEALTHY",
            "GPU_OBSERVATION_UNAVAILABLE",
            "GPU_MEMORY_PRESSURE",
            null
          ]
        },
        "gpu_assignment": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "uuid",
            "name",
            "pci_bus_id",
            "compute_capability",
            "driver_version",
            "total_mib",
            "resource_variant",
            "policy_source"
          ],
          "properties": {
            "uuid": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "pci_bus_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "compute_capability": {
              "type": [
                "string",
                "null"
              ]
            },
            "driver_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "total_mib": {
              "type": "integer",
              "minimum": 1
            },
            "resource_variant": {
              "type": [
                "string",
                "null"
              ]
            },
            "policy_source": {
              "type": "string",
              "enum": [
                "operator",
                "memory_class"
              ]
            }
          }
        },
        "gpu_candidate": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": false,
          "required": [
            "uuid",
            "name",
            "pci_bus_id",
            "compute_capability",
            "driver_version",
            "total_mib",
            "resource_variant",
            "policy_source",
            "admissible",
            "reason_code"
          ],
          "properties": {
            "uuid": {
              "type": [
                "string",
                "null"
              ]
            },
            "name": {
              "type": [
                "string",
                "null"
              ]
            },
            "pci_bus_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "compute_capability": {
              "type": [
                "string",
                "null"
              ]
            },
            "driver_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "total_mib": {
              "type": "integer",
              "minimum": 1
            },
            "resource_variant": {
              "type": [
                "string",
                "null"
              ]
            },
            "policy_source": {
              "type": "string",
              "enum": [
                "operator",
                "memory_class"
              ]
            },
            "admissible": {
              "type": "boolean"
            },
            "reason_code": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        },
        "cpu_profile": {
          "type": "string"
        },
        "gpu_profile": {
          "type": "string"
        }
      }
    }
  }
}
