{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "요청 로그",
      "tooltip": "request_id·오류 코드로 개별 요청을 찾습니다",
      "type": "link",
      "url": "/d/request_log_explorer"
    },
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "GPU 용량",
      "tooltip": "GPU 메모리·온도·컨테이너 자원",
      "type": "link",
      "url": "/d/gpu_capacity_and_oom_risk"
    },
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "오늘 사용량",
      "tooltip": "모델별 요청과 토큰 사용량",
      "type": "link",
      "url": "/d/usage_today"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "메인 모델 요청",
      "description": "Gateway가 local-main 요청을 받는지 보여 줍니다. 모델 전환·기동 중이거나 Runtime Controller가 요청을 막으면 '요청 차단'입니다. 원인은 Control Plane의 메인 모델 화면에서 확인합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "max(main_model_gate_open{service=\"gateway\"})",
          "refId": "A",
          "legendFormat": "",
          "instant": false
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "noValue": "수집 안 됨",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "요청 차단",
                  "index": 0
                },
                "1": {
                  "text": "요청 허용",
                  "index": 1
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "요청 처리량",
      "description": "공개 API(/v1/*)가 초당 처리한 요청 수입니다. 선택한 Window 동안의 평균입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total{service=\"gateway\",route=~\"/v1/.+\"}[$window]))",
          "refId": "A",
          "legendFormat": "",
          "instant": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "수집 안 됨",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "서버 오류율",
      "description": "선택한 Window 동안 공개 API 응답 중 5xx 비율입니다. 요청이 적을 때도 흔들리지 않도록 실제 건수(increase)로 계산합니다. 0%가 정상이며, 0보다 크면 요청 로그에서 error_code를 확인합니다. 스트리밍 도중 SSE로 전달된 오류는 아래 '스트림 종료 결과'에 따로 보입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "(sum(increase(http_requests_total{service=\"gateway\",route=~\"/v1/.+\",status_code=~\"5..\"}[$window])) or vector(0)) / clamp_min(sum(increase(http_requests_total{service=\"gateway\",route=~\"/v1/.+\"}[$window])), 1)",
          "refId": "A",
          "legendFormat": "",
          "instant": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "수집 안 됨",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1e-06
              }
            ]
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "응답 시간 p95",
      "description": "스트리밍이 아닌 Chat 요청이 런타임에서 완료되기까지 걸린 시간의 95번째 백분위입니다. 목표값은 configs/performance/slo.yaml이 소유하므로 여기서는 색으로 판정하지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(upstream_request_duration_seconds_bucket{service=\"gateway\",path=\"chat/completions\"}[$window])))",
          "refId": "A",
          "legendFormat": "",
          "instant": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "수집 안 됨",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "stat",
      "title": "첫 응답 p95 (스트리밍)",
      "description": "스트리밍 요청이 첫 chunk를 받기까지 걸린 시간(TTFT)의 95번째 백분위입니다. 사용자가 체감하는 대기 시간에 가장 가깝습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(streaming_time_to_first_chunk_seconds_bucket{service=\"gateway\"}[$window])))",
          "refId": "A",
          "legendFormat": "",
          "instant": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "수집 안 됨",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "GPU 메모리 여유",
      "description": "DCGM이 관측한 GPU 메모리 중 비어 있는 비율입니다. configs/gpu_budgets.yaml의 운영 상한(avoid_above 0.93)을 넘는 사용, 즉 여유 7% 미만이면 주황입니다. NVIDIA 환경에서만 수집합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "min(DCGM_FI_DEV_FB_FREE / (DCGM_FI_DEV_FB_FREE + DCGM_FI_DEV_FB_USED))",
          "refId": "A",
          "legendFormat": "",
          "instant": false
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "수집 안 됨",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 0.07
              }
            ]
          },
          "decimals": 1
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "요청 결과 추이",
      "description": "공개 API 응답을 상태 코드 계열별로 쌓아 보여 줍니다. 4xx는 요청 형식·인증 문제, 5xx는 플랫폼·런타임 문제입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (status_class) (label_replace(rate(http_requests_total{service=\"gateway\",route=~\"/v1/.+\"}[$window]), \"status_class\", \"${1}xx\", \"status_code\", \"(.)..\") )",
          "refId": "A",
          "legendFormat": "{{status_class}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "noValue": "수집 안 됨",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 18,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "2xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "green"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "4xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "지연 추이",
      "description": "비스트리밍 Chat 응답 시간(p50·p95)과 스트리밍 첫 응답 시간(p95)입니다. 부하가 늘 때 함께 오르는지 비교합니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum by (le) (rate(upstream_request_duration_seconds_bucket{service=\"gateway\",path=\"chat/completions\"}[$window])))",
          "refId": "A",
          "legendFormat": "응답 시간 p50"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(upstream_request_duration_seconds_bucket{service=\"gateway\",path=\"chat/completions\"}[$window])))",
          "refId": "B",
          "legendFormat": "응답 시간 p95"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(streaming_time_to_first_chunk_seconds_bucket{service=\"gateway\"}[$window])))",
          "refId": "C",
          "legendFormat": "첫 응답 p95 (스트리밍)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "수집 안 됨",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 2
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "모델별 처리 중·대기 요청",
      "description": "vLLM이 지금 처리 중인 요청과 실행 슬롯을 기다리는 요청입니다. 메인 모델과 보조 런타임(Embedding·Risk)을 나눠 봅니다. 대기가 계속 0보다 크면 동시 처리 한도에 도달한 것입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum(vllm:num_requests_running{model=\"local-main\"})",
          "refId": "A",
          "legendFormat": "메인 모델 처리 중"
        },
        {
          "expr": "sum(vllm:num_requests_waiting{model=\"local-main\"})",
          "refId": "B",
          "legendFormat": "메인 모델 대기"
        },
        {
          "expr": "sum(vllm:num_requests_running{model!=\"local-main\"})",
          "refId": "C",
          "legendFormat": "보조 런타임 처리 중"
        },
        {
          "expr": "sum(vllm:num_requests_waiting{model!=\"local-main\"})",
          "refId": "D",
          "legendFormat": "보조 런타임 대기"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "수집 안 됨",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "메인 모델 처리 중"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "blue"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "메인 모델 대기"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "보조 런타임 처리 중"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "purple"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "보조 런타임 대기"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "메인 모델 지연 p95 (vLLM)",
      "description": "vLLM이 직접 잰 메인 모델 지연입니다. 첫 토큰(TTFT), 토큰 간격(ITL), 요청 전체(E2E)의 95번째 백분위를 구분해 병목이 prefill인지 decode인지 봅니다. 요청 전체(점선)는 오른쪽 축입니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:time_to_first_token_seconds_bucket{model=\"local-main\"}[$window])))",
          "refId": "A",
          "legendFormat": "첫 토큰 (TTFT)"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:inter_token_latency_seconds_bucket{model=\"local-main\"}[$window])))",
          "refId": "B",
          "legendFormat": "토큰 간격 (ITL)"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(vllm:e2e_request_latency_seconds_bucket{model=\"local-main\"}[$window])))",
          "refId": "C",
          "legendFormat": "요청 전체 (E2E)"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "수집 안 됨",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 6,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "decimals": 2
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "요청 전체 (E2E)"
            },
            "properties": [
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    10,
                    10
                  ]
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "토큰 처리량",
      "description": "모든 vLLM 런타임이 처리한 입력(prompt)과 출력(generation) 토큰의 초당 합계입니다.",
      "datasource": {
