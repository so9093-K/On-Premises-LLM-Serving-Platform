        "colorMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "수집 안 됨",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "수집 안 됨",
                  "color": "transparent",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "DCGM이 관측한 실제 GPU 메모리 사용량입니다. vLLM의 예약 비율과 같을 필요는 없습니다."
    },
    {
