    {
      "id": 3,
      "type": "stat",
      "title": "OOM·재시작",
      "description": "선택한 Window 동안 플랫폼 컨테이너가 재시작하거나 OOM으로 종료된 횟수입니다. 0이 정상이며, 1 이상이면 컨테이너 로그를 확인합니다. '수집 안 됨'은 cAdvisor 수집이 없다는 뜻이며 0으로 읽지 않습니다.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 20,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(changes(container_start_time_seconds{container_label_com_docker_compose_service=~\"gateway|risk-signal-service|main-llm-vllm|embedding-vllm|embedding-ko-vllm|prompt-injection-detector-runtime\"}[$window])) + sum(increase(container_oom_events_total{container_label_com_docker_compose_service=~\"gateway|risk-signal-service|main-llm-vllm|embedding-vllm|embedding-ko-vllm|prompt-injection-detector-runtime\"}[$window]))",
          "refId": "A",
          "legendFormat": "이벤트"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "noValue": "수집 안 됨",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "수집 안 됨",
                  "color": "transparent",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      }
