  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPU 메모리 여유",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "expr": "min(gpu_memory_headroom_bytes)",
          "refId": "A",
          "legendFormat": "여유"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "orange",
                "value": null
              },
              {
                "color": "green",
                "value": 3758096384.0
              }
            ]
          },
          "noValue": "수집 안 됨",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "수집 안 됨",
                  "color": "transparent",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "DCGM이 관측한 실제 GPU 메모리 여유입니다. configs/gpu_budgets.yaml의 reserve hard_minimum(3.5 GiB)보다 작으면 주황입니다. admission 계획의 VRAM 비율과는 다른 값이므로, 정책 판단은 Control Plane의 런타임 화면을 함께 봅니다."
    },
    {
