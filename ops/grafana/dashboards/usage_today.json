  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPU 사용률",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(gpu_utilization_ratio)",
          "refId": "A",
          "legendFormat": "사용률",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "수집 안 됨",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "수집 안 됨",
                  "color": "transparent",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "조회 종료 시점의 GPU별 사용률 중 최댓값입니다. GPU가 연산 중이었던 시간 비율이며 VRAM 사용량과 다릅니다."
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "대상별 호출 수",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (target) (increase(upstream_request_duration_seconds_count{service=\"gateway\"}[$__range])))",
          "refId": "A",
          "legendFormat": "{{target}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "수집 안 됨",
          "min": 0
        },
        "overrides": []
      },
      "description": "선택 기간에 Gateway가 기록한 모델·Risk 서비스 호출 수의 추정치입니다. 외부 API 요청 수와 다릅니다."
    },
    {
      "id": 3,
      "type": "table",
      "title": "요청 거부 (사유별)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(request_validation_rejections_total{service=\"gateway\"}[$__range])) > 0",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "건수",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "없음",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "건수"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "description": "선택 기간에 Gateway가 검증 단계에서 거부한 요청입니다. 수집된 카운터 증가량으로 건수를 추정합니다.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "reason": "사유",
              "Value": "건수"
            },
            "indexByName": {
              "reason": 0,
              "Value": 1
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "vLLM 토큰 처리량",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(vllm_prompt_tokens_per_second)",
          "refId": "A",
          "legendFormat": "입력 tok/s"
        },
        {
          "expr": "sum(vllm_generation_tokens_per_second)",
          "refId": "B",
          "legendFormat": "출력 tok/s"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1,
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "noValue": "수집 안 됨"
        },
        "overrides": []
      },
      "description": "vLLM 전체의 입력·출력 토큰 처리율(최근 5분 평균)입니다. 내부·직접 호출도 포함하며 누적 토큰 수가 아닙니다."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "대상별 호출률",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (target) (rate(upstream_request_duration_seconds_count{service=\"gateway\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{target}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "noValue": "수집 안 됨"
        },
        "overrides": []
      },
      "description": "Gateway가 기록한 대상별 호출의 초당 처리율입니다. 평균 구간은 조회 범위와 수집 간격에 따라 자동 조정됩니다."
    },
    {
      "id": 6,
      "type": "table",
      "title": "대상별 호출 오류 (코드별)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (target, code) (increase(upstream_errors_total{service=\"gateway\"}[$__range])) > 0",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "건수",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "없음",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "건수"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "description": "선택 기간에 Gateway의 대상별 호출에서 기록된 오류입니다. 대상·코드별 건수는 수집된 카운터 증가량의 추정치입니다.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "target": "대상",
              "code": "코드",
              "Value": "건수"
            },
            "indexByName": {
              "target": 0,
              "code": 1,
              "Value": 2
            }
          }
        }
      ]
    }
