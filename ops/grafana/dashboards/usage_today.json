{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "서비스 개요",
      "tooltip": "요청·오류·지연",
      "type": "link",
      "url": "/d/service_overview"
    },
    {
      "asDropdown": false,
      "icon": "dashboard",
      "includeVars": false,
      "keepTime": true,
      "tags": [],
      "targetBlank": false,
      "title": "GPU 용량",
      "tooltip": "GPU 메모리·온도·컨테이너 자원",
      "type": "link",
      "url": "/d/gpu_capacity_and_oom_risk"
    }
  ],
  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "GPU 사용률",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(gpu_utilization_ratio)",
          "refId": "A",
          "legendFormat": "사용률"
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "수집 안 됨",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "수집 안 됨",
                  "color": "transparent",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "GPU가 연산 중이었던 시간 비율입니다. 서빙 중에는 높은 값이 정상이므로 색으로 판정하지 않습니다."
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "모델별 요청 (많은 순)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum by (target) (rate(upstream_request_duration_seconds_count{service=\"gateway\"}[$window]))",
          "refId": "A",
          "legendFormat": "{{target}}"
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "수집 안 됨"
        },
        "overrides": []
      },
      "description": "선택한 Window 동안 Gateway가 모델별로 보낸 초당 요청 수입니다. 가장 긴 막대가 주 사용 모델입니다."
    },
    {
      "id": 3,
      "type": "table",
      "title": "요청 거부 (사유별)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(request_validation_rejections_total[$window])) > 0",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "건수",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "없음",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "건수"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "description": "선택한 Window 동안 Gateway가 검증에서 거부한 요청을 사유별로 셉니다. 사용자 입력 내용은 label에 들어가지 않습니다.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "reason": "사유",
              "Value": "건수"
            },
            "indexByName": {
              "reason": 0,
              "Value": 1
            }
          }
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "토큰 처리량: 입력과 출력",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(vllm_prompt_tokens_per_second)",
          "refId": "A",
          "legendFormat": "입력 tok/s"
        },
        {
          "expr": "sum(vllm_generation_tokens_per_second)",
          "refId": "B",
          "legendFormat": "출력 tok/s"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1,
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "noValue": "수집 안 됨"
        },
        "overrides": []
      },
      "description": "토큰 처리량을 입력(prompt)과 출력(generation)으로 나눕니다. 입력이 치솟으면 긴 컨텍스트, 출력이 치솟으면 긴 생성 부하입니다."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "모델별 요청 추이",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (target) (rate(upstream_request_duration_seconds_count{service=\"gateway\"}[$window]))",
          "refId": "A",
          "legendFormat": "{{target}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "noValue": "수집 안 됨"
        },
        "overrides": []
      },
      "description": "모델별 요청량이 시간에 따라 어떻게 변하는지 봅니다."
    },
    {
      "id": 6,
      "type": "table",
      "title": "Upstream 오류 (코드별)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (target, code) (increase(upstream_errors_total[$window])) > 0",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "건수",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "없음",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "건수"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "description": "선택한 Window 동안 Gateway가 런타임을 호출하다 받은 오류를 대상과 코드별로 셉니다(QUEUE_TIMEOUT, CIRCUIT_OPEN, GATEWAY_TIMEOUT 등).",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "target": "대상",
              "code": "코드",
              "Value": "건수"
            },
            "indexByName": {
              "target": 0,
              "code": 1,
              "Value": 2
            }
          }
        }
      ]
    }
  ],
