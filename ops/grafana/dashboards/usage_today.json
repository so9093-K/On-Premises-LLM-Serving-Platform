  "liveNow": false,
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "현재 GPU 사용률",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "max(gpu_utilization_ratio)",
          "refId": "A",
          "legendFormat": "사용률",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "noValue": "수집 안 됨",
          "mappings": [
            {
              "type": "special",
              "options": {
                "match": "null+nan",
                "result": {
                  "text": "수집 안 됨",
                  "color": "transparent",
                  "index": 0
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "description": "선택한 기간의 합계/평균이 아닌 조회 마지막 시점의 GPU 사용률 최댓값입니다. CPU-only 구성에서는 값이 없을 수 있습니다."
    },
    {
      "id": 2,
      "type": "bargauge",
      "title": "공개 API 요청 수 (경로별)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "sort_desc(sum by (route) (increase(http_requests_total{service=\"gateway\",route=~\"/v1/.+\"}[$__range])))",
          "refId": "A",
          "legendFormat": "{{route}}",
          "instant": true
        }
      ],
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "showUnfilled": true,
        "valueMode": "color",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "blue",
                "value": null
              }
            ]
          },
          "noValue": "수집 안 됨",
          "min": 0
        },
        "overrides": []
      },
      "description": "선택 기간 동안 Gateway의 공개 /v1/* API 경로별 요청 수입니다. Prometheus 카운터 증가량의 추정치이며 내부 모델 호출 횟수와 다릅니다."
    },
    {
      "id": 3,
      "type": "table",
      "title": "공개 API 요청 거부 (사유별)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "expr": "sum by (reason) (increase(request_validation_rejections_total{service=\"gateway\"}[$__range])) > 0",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "건수",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "없음",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "건수"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "description": "선택 기간 동안 Gateway가 검증 단계에서 거부한 공개 API 요청입니다. 해당 요청의 개별 진단은 요청 로그를 사용하세요.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "reason": "사유",
              "Value": "건수"
            },
            "indexByName": {
              "reason": 0,
              "Value": 1
            }
          }
        }
      ]
    },
    {
      "id": 7,
      "title": "입력 토큰 합계 (Loki)",
      "type": "stat",
      "description": "선택한 기간에 Loki 애플리케이션 완료 이벤트에서 관측된 Chat·Responses의 입력 토큰 합계입니다. HTTP 요청 수나 vLLM tok/s와 다르며 usage가 누락된 요청은 포함되지 않습니다. CPU llama.cpp와 GPU vLLM 요청을 모두 포함할 수 있지만, 로그 수집이 중단되면 누락됩니다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "수집 안 됨",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "direction": "backward",
          "expr": "sum(sum_over_time({job=\"application\",service=\"gateway\"} | json | event=\"http_request_completed\" | route=~\"/v1/(chat/completions|responses)\" | unwrap prompt_tokens | __error__=\"\" [$__range]))"
        }
      ]
    },
    {
      "id": 8,
      "title": "출력 토큰 합계 (Loki)",
      "type": "stat",
      "description": "선택한 기간에 Loki 애플리케이션 완료 이벤트에서 관측된 Chat·Responses의 출력 토큰 합계입니다. HTTP 요청 수나 vLLM tok/s와 다르며 usage가 누락된 요청은 포함되지 않습니다. CPU llama.cpp와 GPU vLLM 요청을 모두 포함할 수 있지만, 로그 수집이 중단되면 누락됩니다.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 5
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "수집 안 됨",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "center",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "direction": "backward",
          "expr": "sum(sum_over_time({job=\"application\",service=\"gateway\"} | json | event=\"http_request_completed\" | route=~\"/v1/(chat/completions|responses)\" | unwrap completion_tokens | __error__=\"\" [$__range]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "vLLM 토큰 처리율 (GPU Runtime)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum(vllm_prompt_tokens_per_second)",
          "refId": "A",
          "legendFormat": "입력 tok/s"
        },
        {
          "expr": "sum(vllm_generation_tokens_per_second)",
          "refId": "B",
          "legendFormat": "출력 tok/s"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: tok/s",
          "decimals": 1,
          "custom": {
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "noValue": "수집 안 됨"
        },
        "overrides": []
      },
      "description": "vLLM 런타임의 최근 토큰 처리 속도(tok/s)입니다. 요청별/기간별 누적 토큰 사용량이 아니며 CPU llama.cpp Runtime에는 해당하지 않습니다."
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "공개 API 요청률",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (route) (rate(http_requests_total{service=\"gateway\",route=~\"/v1/.+\"}[$__rate_interval]))",
          "refId": "A",
          "legendFormat": "{{route}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "noValue": "수집 안 됨"
        },
        "overrides": []
      },
      "description": "Gateway가 처리한 공개 /v1/* API 요청의 초당 처리율입니다. 모델 Runtime에 대한 내부 요청률과 다릅니다."
    },
    {
      "id": 6,
      "type": "table",
      "title": "내부 모델 호출 오류 (대상·코드별)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 7
      },
      "targets": [
        {
          "expr": "sum by (target, code) (increase(upstream_errors_total{service=\"gateway\"}[$__range])) > 0",
          "refId": "A",
          "legendFormat": "",
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "건수",
            "desc": true
          }
        ],
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "없음",
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "건수"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 90
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "orange"
                }
              }
            ]
          }
        ]
      },
      "description": "Gateway→Model Runtime의 내부 호출 오류입니다. 외부 API 4xx/5xx 전체 집계가 아닙니다. 공개 요청의 실패 원인은 요청 로그에서 확인하세요.",
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "target": "대상",
              "code": "코드",
              "Value": "건수"
            },
            "indexByName": {
              "target": 0,
              "code": 1,
              "Value": 2
            }
          }
        }
      ]
    }
  ],
